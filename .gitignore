venv/
third_party/*/
build/
work/
logs/
audio/native_nes/
audio/msx_reference/
audio/mp3/
*.o
*.map
*.dbg

# Never add credentials, environment secrets or editor state.
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
