# Commercial inputs and private source caches stay local.
inputs/*.zip
private_sources/
*.nes
*.rom
*.ROM
*.nsf
*.kss
*.mp3
*.wav
*.7z

# Reproducible outputs, fetched upstream source and temporary build products.
