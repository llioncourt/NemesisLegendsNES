# Commercial inputs and private source caches stay local.
inputs/*.zip
private_sources/
*.nes
*.rom
*.ROM
*.nsf
*.kss
*.mp3
*.wav
*.7z

# Reproducible outputs, fetched upstream source and temporary build products.
__pycache__/
*.pyc
.venv/
venv/
third_party/*/
build/
work/
logs/
audio/native_nes/
audio/msx_reference/
audio/mp3/
*.o
*.map
*.dbg

# Never add credentials, environment secrets or editor state.
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# Regenerated source assets include complete donor PRG data: never stage these.
assets/msx/
assets/nes/
assets/title/
third_party/ACQUISITION.json
audio/metadata.json
audio/tracklist.csv
audio/listen_all.m3u8
audio/suno_prompt_metadata.json
